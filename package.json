  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "api:types": "openapi-typescript http://localhost:8080/api/v3/api-docs -o src/app/api/schema.d.ts",
    "contract:check": "tsc -p tsconfig.contract.json",
